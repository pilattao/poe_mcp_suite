{
  "mcpServers": {
    "pob": {
      "command": "node",
      "args": [
        "/CHANGE_ME/poe_mcp_suite/pob-mcp/build/index.js"
      ],
      "env": {
        "POE_GAME": "poe2",
        "POE_LEAGUE": "Forbidden Rites",
        "POB_INSTALL_DIR": "C:/Users/CHANGE_ME/AppData/Roaming/Path of Building Community (PoE2)",
        "POB_DIRECTORY": "C:/Users/CHANGE_ME/Documents/Path of Building (PoE2)/Builds",
        "POB_LUA_ENABLED": "true",
        "POB_API_TCP": "true",
        "POB_API_TCP_PORT": "59166",
        "POB_RECONNECT_TIMEOUT_MS": "10000",
        "POB_TIMEOUT_MS": "30000",
        "POB_MAX_RESPONSE_CHARS": "0",
        "POE_TRADE_ENABLED": "false"
      }
    },
    "poe-trade-mcp": {
      "command": "/CHANGE_ME/poe_mcp_suite/.venv/bin/python",
      "args": [
        "/CHANGE_ME/poe_mcp_suite/poe-trade-mcp/poe_all.py"
      ],
      "env": {
        "POE_GAME": "poe2",
        "POE_LEAGUE": "Forbidden Rites",
        "POE_NINJA_LEAGUE_SLUG": "forbiddenrites"
      }
    },
    "poe-data-mcp": {
      "command": "/CHANGE_ME/poe_mcp_suite/.venv/bin/python",
      "args": [
        "/CHANGE_ME/poe_mcp_suite/poe-data-mcp/server.py"
      ],
      "env": {
        "POE_GAME": "poe2",
        "POE_LEAGUE": "Forbidden Rites",
        "POB_INSTALL_DIR": "C:/Users/CHANGE_ME/AppData/Roaming/Path of Building Community (PoE2)"
      }
    }
  }
}
